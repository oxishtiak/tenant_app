# Copy to .env for local development. Production must override DJANGO_SECRET_KEY.
DJANGO_SECRET_KEY=dev-insecure-secret-key-change-in-prod
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Uncomment for PostgreSQL (preferred). Otherwise SQLite db.sqlite3 is used.
POSTGRES_DB=tenantapp
POSTGRES_USER=tenantapp
POSTGRES_PASSWORD=tenantapp
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
